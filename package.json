{
	"name": "locabase",
	"version": "1.2.0",
	"description": "Desktop control room for Supabase — run the local stack, edit config.toml from a UI, and diff/deploy against managed or self-hosted projects.",
	"main": "./out/main/index.js",
	"author": "Elchin Abilov",
	"license": "Apache-2.0",
	"homepage": "https://github.com/elchinabilov/Locabase#readme",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/elchinabilov/Locabase.git"
	},
	"bugs": {
		"url": "https://github.com/elchinabilov/Locabase/issues"
	},
	"keywords": [
		"supabase",
		"electron",
		"postgres",
		"self-hosted",
		"database-gui",
		"devtools",
		"sql-editor",
		"migrations",
		"edge-functions"
	],
	"type": "module",
	"scripts": {
		"dev": "electron-vite dev",
		"build": "npm run typecheck && electron-vite build",
		"icons": "electron scripts/make-icons.mjs",
		"start": "electron-vite preview",
		"typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"dist:mac": "npm run build && electron-builder --mac --arm64",
		"dist:win": "npm run build && electron-builder --win --x64",
		"screenshots": "node scripts/capture-screenshots.mjs",
		"clean": "rm -rf dist out *.tsbuildinfo",
		"prepare": "husky"
	},
	"dependencies": {
		"@codemirror/autocomplete": "^6.20.3",
		"@codemirror/commands": "^6.11.0",
		"@codemirror/lang-sql": "^6.10.0",
		"@codemirror/language": "^6.12.4",
		"@codemirror/search": "^6.7.2",
		"@codemirror/state": "^6.7.4",
		"@codemirror/view": "^6.43.11",
		"@electron-toolkit/utils": "^4.0.0",
		"@lezer/highlight": "^1.2.3",
		"dockerode": "^4.0.2",
		"electron-store": "^11.0.2",
		"pg": "^8.13.1",
		"smol-toml": "^1.3.1",
		"zod": "^3.24.1"
	},
	"devDependencies": {
		"@eslint/js": "^9.39.5",
		"@tailwindcss/vite": "^4.0.0",
		"@testing-library/dom": "^10.4.1",
		"@testing-library/jest-dom": "^7.0.1",
		"@testing-library/react": "^16.3.3",
		"@types/dockerode": "^3.3.31",
		"@types/node": "^22.10.2",
		"@types/pg": "^8.11.10",
		"@types/react": "^19.0.2",
		"@types/react-dom": "^19.0.2",
		"@vitejs/plugin-react": "^4.3.4",
		"@vitest/coverage-v8": "^3.2.7",
		"electron": "^38.0.0",
		"electron-builder": "^26.0.0",
		"electron-vite": "^5.0.0",
		"eslint": "^9.39.5",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-import": "^2.32.0",
		"eslint-plugin-jsx-a11y": "^6.10.2",
		"eslint-plugin-react-hooks": "^7.1.1",
		"eslint-plugin-react-refresh": "^0.5.6",
		"husky": "^9.1.7",
		"jsdom": "^29.1.1",
		"lint-staged": "^16.4.0",
		"prettier": "^3.9.6",
		"react": "^19.0.0",
		"react-dom": "^19.0.0",
		"tailwindcss": "^4.0.0",
		"typescript": "^5.7.2",
		"typescript-eslint": "^8.70.0",
		"vite": "^7.0.0",
		"vitest": "^3.0.0"
	},
	"lint-staged": {
		"*.{ts,tsx,js,mjs}": [
			"eslint --fix",
			"prettier --write"
		],
		"*.{json,md,yml,css,html}": [
			"prettier --write"
		]
	}
}
