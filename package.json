{
	"name": "localbase",
	"version": "0.1.1",
	"description": "Localbase — Supabase control room: local stack, config, auth, functions and local↔remote sync for managed and self-hosted projects",
	"main": "./out/main/index.js",
	"author": "Elchin Abilov",
	"license": "UNLICENSED",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "electron-vite dev",
		"build": "npm run typecheck && electron-vite build",
		"icons": "electron scripts/make-icons.mjs",
		"start": "electron-vite preview",
		"typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
		"test": "vitest run",
		"test:watch": "vitest",
		"dist:mac": "npm run build && electron-builder --mac --arm64",
		"dist:win": "npm run build && electron-builder --win --x64"
	},
	"dependencies": {
		"@codemirror/autocomplete": "^6.20.3",
		"@codemirror/commands": "^6.11.0",
		"@codemirror/lang-sql": "^6.10.0",
		"@codemirror/language": "^6.12.4",
		"@codemirror/search": "^6.7.2",
		"@codemirror/state": "^6.7.4",
		"@codemirror/view": "^6.43.11",
		"@electron-toolkit/preload": "^3.0.1",
		"@electron-toolkit/utils": "^4.0.0",
		"@lezer/highlight": "^1.2.3",
		"dockerode": "^4.0.2",
		"dotenv": "^16.4.5",
		"electron-store": "^10.0.0",
		"pg": "^8.13.1",
		"smol-toml": "^1.3.1",
		"zod": "^3.24.1"
	},
	"devDependencies": {
		"@tailwindcss/vite": "^4.0.0",
		"@types/dockerode": "^3.3.31",
		"@types/node": "^22.10.2",
		"@types/pg": "^8.11.10",
		"@types/react": "^19.0.2",
		"@types/react-dom": "^19.0.2",
		"@vitejs/plugin-react": "^4.3.4",
		"electron": "^38.0.0",
		"electron-builder": "^26.0.0",
		"electron-vite": "^5.0.0",
		"react": "^19.0.0",
		"react-dom": "^19.0.0",
		"tailwindcss": "^4.0.0",
		"typescript": "^5.7.2",
		"vite": "^7.0.0",
		"vitest": "^3.0.0"
	}
}
